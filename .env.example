# KVCET Hostel Management System — server configuration.
# Copy to `.env` and adjust. Never commit a real `.env`.
# All values below are read only by the Node server; nothing here is bundled into browser code.

# HTTP port for the API + built SPA (`npm start` / `npm run server`).
PORT=5000

# SQLite database file (created and migrated automatically on start). Back this file up.
DB_PATH=./data/kvcet.db

# Institution timezone used for "today", day boundaries, curfew and deadline display.
APP_TIMEZONE=Asia/Kolkata

# Sessions: idle timeout (minutes), normal session length (hours), "remember me" length (days).
SESSION_IDLE_MINUTES=120
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=7

# Mark the session cookie Secure (always on when NODE_ENV=production). Requires HTTPS.
COOKIE_SECURE=false

# Set to true only when running behind a single trusted reverse proxy (for correct client IPs).
TRUST_PROXY=false

# Extra allowed browser origins for state-changing requests, comma separated
# (same-origin requests are always allowed). Example: https://hostel.kvcet.edu.in
ALLOWED_ORIGINS=

# Set to false to silence per-request logging.
LOG_REQUESTS=true

# Optional: used non-interactively by `npm run admin:create` instead of prompting.
# ADMIN_PASSWORD=

# Optional: password for accounts created by `npm run db:seed-demo` (demo data only).
# DEMO_PASSWORD=Demo@12345

# Not used by this application (left over from the original AI Studio template).
# GEMINI_API_KEY=
